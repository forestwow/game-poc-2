<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Understudies.Core\Understudies.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The capture is played by the doors player of the guard: the one file, not a copy of it. -->
    <!-- ponytail: the whole file ships, the orbit player and the players' runner too; the players move to a file of
         their own that both projects take when that ever matters. -->
    <Compile Include="..\..\tests\Understudies.Core.Tests\ScriptedPlayers.cs" Link="ScriptedPlayers.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- A copy of the committed numbers goes beside the executable, for a build that leaves the repository. -->
    <None Include="..\..\tuning.json" Link="tuning.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The nights' overlays (plan T51) go with the numbers they are laid over. Nothing in the game reads them yet. -->
    <None Include="..\..\nights.json" Link="nights.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\art\ludo\sprites\*.png" Link="art\ludo\sprites\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The cards' pictures (plan T47): the nine the game reads, and nothing of the candidates' folder. -->
    <None Include="..\..\art\ludo\cards\*.png" Link="art\ludo\cards\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The two faces, each family's licence text with it: the licence asks that it goes where the files go. -->
    <None Include="..\..\fonts\**\*.ttf;..\..\fonts\**\OFL.txt" Link="fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
